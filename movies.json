import json
import re

input_file = "/storage/emulated/0/Music/playlist_rictms_plus.txt"
output_file = "/storage/emulated/0/Music/movies.json"

movies = []

with open(input_file, "r", encoding="utf-8") as f:
    lines = [line.strip() for line in f if line.strip()]

i = 0
while i < len(lines):
    if lines[i].startswith("#EXTINF"):
        extinf_line = lines[i]

        # Ensure there is a following line for the URL
        if i + 1 < len(lines) and not lines[i + 1].startswith("#"):
            media_url = lines[i + 1]

            # Extract TVG Logo (image URL)
            logo_match = re.search(r'tvg-logo="([^"]+)"', extinf_line)
            image_url = logo_match.group(1) if logo_match else ""

            # Extract Title (text after the last comma)
            title = extinf_line.rsplit(",", 1)[-1].strip()

            movies.append(
                {
                    "image": image_url,
                    "category": "Movie Library",
                    "title": title,
                    "url": media_url,
                }
            )

            i += 2
        else:
            i += 1
    else:
        i += 1

# Write to movies.json
with open(output_file, "w", encoding="utf-8") as f:
    json.dump(movies, f, indent=4, ensure_ascii=False)

print(
    f"Successfully converted {len(movies)} entries and saved to {output_file}"
)
